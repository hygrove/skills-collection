<#
  dev.ps1 - {{SERVICE_NAME}} dev launcher (generated by vs-dep skill)
  Starts backend (:{{BACKEND_PORT}}) and frontend (:{{FRONTEND_PORT}}).
  Idempotent: services already listening on their ports are skipped.
  Pure ASCII on purpose (PowerShell 5.1 reads .ps1 as ANSI without BOM).
#>
Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned -Force

$root        = Resolve-Path (Join-Path $PSScriptRoot '..')
$backendExe  = Join-Path $root '{{BACKEND_EXE}}'
$backendArgs = '{{BACKEND_ARGS}}'
$frontendDir = Join-Path $root '{{FRONTEND_DIR}}'
$frontendCmd = '{{FRONTEND_CMD}}'

function Test-PortListening($port) {
    try {
        $c = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
        return ($null -ne $c)
    } catch {
        return $false
    }
}

Write-Host "`n=== {{SERVICE_NAME}} dev launcher ===`n" -ForegroundColor Magenta

# ---------- Backend ----------
if (Test-PortListening {{BACKEND_PORT}}) {
    Write-Host "[OK] Backend :{{BACKEND_PORT}} already running, skip." -ForegroundColor Green
} else {
    if (Test-Path $backendExe) {
        Write-Host "[>>] Starting backend -> http://127.0.0.1:{{BACKEND_PORT}} ..." -ForegroundColor Cyan
        Start-Process -FilePath $backendExe -ArgumentList $backendArgs -NoNewWindow -WorkingDirectory $root
    } else {
        Write-Host "[X] Backend executable not found: $backendExe" -ForegroundColor Red
    }
}

# ---------- Frontend ----------
if (Test-PortListening {{FRONTEND_PORT}}) {
    Write-Host "[OK] Frontend :{{FRONTEND_PORT}} already running, skip." -ForegroundColor Green
} else {
    Write-Host "[>>] Starting frontend -> http://localhost:{{FRONTEND_PORT}} ..." -ForegroundColor Cyan
    Start-Process -FilePath "cmd.exe" -ArgumentList "/c", $frontendCmd -NoNewWindow -WorkingDirectory $frontendDir
}

Write-Host "`n[WEB] Frontend:  http://localhost:{{FRONTEND_PORT}}" -ForegroundColor Yellow
Write-Host "[API] Backend:   http://127.0.0.1:{{BACKEND_PORT}}" -ForegroundColor Yellow
Write-Host "(Background services stop when this terminal closes.)`n" -ForegroundColor Gray
