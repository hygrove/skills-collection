<#
  start-prod.ps1 - {{SERVICE_NAME}} PRODUCTION launcher (generated by vs-dep skill)
  1) Build the frontend into dist/
  2) Start the backend in production mode (multi-worker, no reload)
  Pure ASCII on purpose (PowerShell 5.1 reads .ps1 as ANSI without BOM).
#>
Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned -Force

$root        = Resolve-Path (Join-Path $PSScriptRoot '..')
$backendExe  = Join-Path $root '{{BACKEND_EXE}}'
$backendArgs = '{{PROD_BACKEND_ARGS}}'
$frontendDir = Join-Path $root '{{FRONTEND_DIR}}'
$buildCmd    = '{{FRONTEND_BUILD_CMD}}'

Write-Host "`n=== {{SERVICE_NAME}} PRODUCTION launcher ===`n" -ForegroundColor Magenta

# ---------- Build frontend ----------
Write-Host "[>>] Building frontend (npm run build)..." -ForegroundColor Cyan
$build = Start-Process -FilePath "cmd.exe" -ArgumentList "/c", $buildCmd -NoNewWindow -WorkingDirectory $frontendDir -Wait -PassThru
if ($build.ExitCode -ne 0) {
    Write-Host "[X] Frontend build failed (exit $($build.ExitCode)). Aborting." -ForegroundColor Red
    exit 1
}
Write-Host "[OK] Frontend built." -ForegroundColor Green

# ---------- Start backend (production) ----------
Write-Host "[>>] Starting backend (production) -> http://0.0.0.0:{{BACKEND_PORT}} ..." -ForegroundColor Cyan
Start-Process -FilePath $backendExe -ArgumentList $backendArgs -NoNewWindow -WorkingDirectory $root

Write-Host "`n[SRV] Backend (prod): http://127.0.0.1:{{BACKEND_PORT}}" -ForegroundColor Yellow
Write-Host "[NOTE] For static frontend + TLS, put nginx in front:" -ForegroundColor Gray
Write-Host "      proxy /      -> dist/   (or mount StaticFiles in the backend)" -ForegroundColor Gray
Write-Host "      proxy /api   -> http://127.0.0.1:{{BACKEND_PORT}}`n" -ForegroundColor Gray
